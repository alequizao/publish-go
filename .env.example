# ───────────────────────────────────────────────
#  Publish Go — Configuração de ambiente
#  Copie este arquivo para `.env` e ajuste os valores.
# ───────────────────────────────────────────────

APP_NAME="Publish Go"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://publishdev.com.br
APP_TIMEZONE=America/Sao_Paulo
# Prefixo da URL quando hospedado em subpasta (ex.: /publishgo). Vazio = raiz do domínio.
APP_BASE=/publishgo

# ── Banco de dados (MySQL 5.7+) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=publishgo
DB_USERNAME=publishgo
DB_PASSWORD=publishgo
DB_CHARSET=utf8mb4

# ── Conta privilegiada (opcional) ──
# Usada SOMENTE pelo bin/migrate.php caso o banco/usuário ainda não exista.
# Se o banco já existe (recomendado via aaPanel), deixe em branco.
DB_ROOT_USERNAME=
DB_ROOT_PASSWORD=

# ── JWT ──
# Troque por uma string longa e aleatória em produção!
JWT_SECRET=troque-este-segredo-por-uma-chave-aleatoria-bem-longa-2026
JWT_TTL=3600
JWT_REFRESH_TTL=1209600

# ── WebSocket (Workerman) ──
WS_HOST=0.0.0.0
WS_PORT=8181
# URL pública que o navegador usa para conectar (ws:// ou wss://)
WS_PUBLIC_URL=ws://localhost:8181
# Segredo compartilhado entre a API e o servidor WS para publicar eventos
WS_INTERNAL_SECRET=segredo-interno-da-ponte-ws-2026

# ── Segurança ──
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60
CORS_ALLOW_ORIGIN=*
