[Unit]
Description=Publish Go - WebSocket Server (Workerman)
After=network.target mysql.service

[Service]
Type=forking
User=www
Group=www
WorkingDirectory=/www/wwwroot/publishdev.com.br/publishgo
ExecStart=/usr/bin/php bin/ws-server.php start -d
ExecStop=/usr/bin/php bin/ws-server.php stop
ExecReload=/usr/bin/php bin/ws-server.php reload
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
